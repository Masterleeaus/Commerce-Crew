      "ext_chatbot_order_exceptions",
      "ext_chatbot_order_exception_events",
      "ext_chatbot_order_workbench_actions"
    ],
    "shared_tables": [
      "ext_chatbots"
    ]
  },
  "queues": {
    "used": true,
    "queue_names": [
      "chatbot-ecommerce-marketplace-read",
      "chatbot-ecommerce-marketplace-write",
      "chatbot-ecommerce-inventory-reconciliation",
      "chatbot-ecommerce-payment-webhooks"
    ],
    "tenant_context_required": true
  },
  "schedules": [
    {
      "key": "chatbot-ecommerce:expire-reservations",
      "frequency": "everyMinute",
      "on_one_server": true,
      "without_overlapping": true
    },
    {
      "key": "chatbot-ecommerce:carts-expire",
      "frequency": "hourly",
      "on_one_server": true,
      "without_overlapping": true
    },
    {
      "key": "chatbot-ecommerce:expire-coupon-usages",
      "frequency": "everyFiveMinutes",
      "on_one_server": true,
      "without_overlapping": true
    },
    {
      "key": "chatbot-ecommerce:expire-checkouts",
      "frequency": "everyMinute",
      "on_one_server": true,
      "without_overlapping": true
    },
    {
      "key": "chatbot-ecommerce:expire-shipping-quotes",
      "frequency": "everyMinute",
      "on_one_server": true,
      "without_overlapping": true
    },
    {
      "key": "chatbot-ecommerce:rental-hire-generate-charges",
      "frequency": "daily",
      "on_one_server": true,
      "without_overlapping": true
    },
    {
      "key": "chatbot-ecommerce:rental-hire-expire-payments",
      "frequency": "hourly",
      "on_one_server": true,
      "without_overlapping": true
    },
    {
      "key": "chatbot-ecommerce:payments-expire",
      "frequency": "everyMinute",
      "on_one_server": true,
      "without_overlapping": true
    },
    {
      "key": "chatbot-ecommerce:bnpl-expire",
      "frequency": "everyMinute",
      "on_one_server": true,
      "without_overlapping": true
    },
    {
      "key": "chatbot-ecommerce:contexts-expire",
      "frequency": "hourly",
      "on_one_server": true,
      "without_overlapping": true
    },
    {
      "key": "chatbot-ecommerce:payment-webhooks-retry",
      "frequency": "everyMinute",
      "on_one_server": true,
      "without_overlapping": true
    },
    {
      "key": "chatbot-ecommerce:marketplace-import-orders",
      "frequency": "hourly",
      "on_one_server": true,
      "without_overlapping": true
    },
    {
      "key": "chatbot-ecommerce:marketplace-scan-inventory",
      "frequency": "everyFiveMinutes",
      "on_one_server": true,
      "without_overlapping": true
    }
  ],
  "webhooks": [
    {
      "provider": "payment-provider",
      "verification": "HMAC-SHA256 timestamp.payload",
      "fail_closed": true,
      "idempotency": true,
      "replay_window_seconds": 300,
      "processing": "persist-acknowledge-queue",
      "queue": "chatbot-ecommerce-payment-webhooks",
      "dead_letter": true
    }
  ],
  "billing": {
    "mode": "none",
    "reservation_required": false,
    "ledger": "ext_chatbot_payment_intents"
  },
  "data": {
    "tenant_key": "chatbot_id",
    "default_uninstall_policy": "retain",
    "owned_paths": [
      "docs/superpowers/plans/2026-08-03-three-role-commerce.md",
      "openapi/conversational-commerce-v1.yaml",
      "docs/superpowers/plans/2026-08-03-marketplace-read-mode.md",
      "docs/superpowers/plans/2026-08-03-marketplace-write-safety.md"
    ],
    "credential_storage": "credential-vault"
  },
  "lifecycle": {
    "register_key": true,
    "uninstall": true,
    "idempotent": true,
    "supports_disable": true,
    "upgrade_strategy": "forward-only additive migrations with financial data retention"
  },
  "tests": [
    "unit",
    "feature",
    "architecture",
    "security"
  ],
  "support": {
    "telegram": "heew_support",
    "documentation": "README.md"
  }
}
