    "chatbot-ecommerce.manage-marketplace-connections",
    "chatbot-ecommerce.import-marketplace-orders",
    "chatbot-ecommerce.prepare-marketplace-writes",
    "chatbot-ecommerce.approve-marketplace-writes",
    "chatbot-ecommerce.execute-marketplace-writes",
    "chatbot-ecommerce.rollback-marketplace-writes",
    "chatbot-ecommerce.prepare-marketplace-bulk-writes",
    "chatbot-ecommerce.approve-marketplace-bulk-writes",
    "chatbot-ecommerce.execute-marketplace-bulk-writes",
    "chatbot-ecommerce.rollback-marketplace-bulk-writes",
    "chatbot-ecommerce.manage-brand-voice",
    "chatbot-ecommerce.manage-product-content",
    "chatbot-ecommerce.manage-listing-compliance",
    "chatbot-ecommerce.prepare-listing-rewrites",
    "chatbot-ecommerce.manage-marketplace-inventory-mappings",
    "chatbot-ecommerce.scan-marketplace-inventory",
    "chatbot-ecommerce.resolve-marketplace-inventory-conflicts",
    "chatbot-ecommerce.manage-credentials",
    "chatbot-ecommerce.issue-session-authority",
    "chatbot-ecommerce.manage-order-workbench",
    "chatbot-ecommerce.import-settlements",
    "chatbot-ecommerce.resolve-order-exceptions"
  ],
  "external_hosts": [],
  "routes": [
    {
      "profile": "authenticated-user",
      "prefix": "dashboard/chatbot-ecommerce",
      "name_prefix": "dashboard.chatbot-ecommerce."
    },
    {
      "profile": "public-embed",
      "prefix": "api/v2/chatbot",
      "name_prefix": "api.v2.chatbot."
    },
    {
      "profile": "public-embed",
      "prefix": "api/v3/chatbot/ecommerce",
      "name_prefix": "api.v3.chatbot.ecommerce."
    },
    {
      "profile": "admin",
      "prefix": "api/v3/chatbot/ecommerce",
      "name_prefix": "api.v3.chatbot.ecommerce.admin."
    },
    {
      "profile": "public-webhook",
      "prefix": "api/v3/chatbot/ecommerce/payment-webhooks",
      "name_prefix": "api.v3.chatbot.ecommerce.payment-webhooks."
    }
  ],
  "database": {
    "migrations": true,
    "owned_tables": [
      "ext_chatbot_bnpl_offers",
      "ext_chatbot_bnpl_provider_profiles",
      "ext_chatbot_cart_lines",
      "ext_chatbot_cart_operations",
      "ext_chatbot_carts",
      "ext_chatbot_checkout_operations",
      "ext_chatbot_checkout_sessions",
      "ext_chatbot_commerce_action_journal",
      "ext_chatbot_commerce_communication_actions",
      "ext_chatbot_commerce_communication_messages",
      "ext_chatbot_commerce_communication_policies",
      "ext_chatbot_commerce_communication_threads",
      "ext_chatbot_commerce_contexts",
      "ext_chatbot_commerce_error_lexicon",
      "ext_chatbot_commerce_escalations",
      "ext_chatbot_commerce_order_events",
      "ext_chatbot_commerce_order_items",
      "ext_chatbot_commerce_orders",
      "ext_chatbot_commerce_return_items",
      "ext_chatbot_commerce_returns",
      "ext_chatbot_commerce_spend_limits",
      "ext_chatbot_coupon_usages",
      "ext_chatbot_coupons",
      "ext_chatbot_fulfillment_items",
      "ext_chatbot_fulfillments",
      "ext_chatbot_inventory",
