    "commerce.marketplace-bulk-partial-rollback",
    "commerce.listing-intelligence",
    "commerce.marketplace-compliance",
    "commerce.brand-voice-profiles",
    "commerce.evidence-backed-claims",
    "commerce.safe-listing-rewrites",
    "commerce.marketplace-inventory-reconciliation",
