  "contributions": [],
  "permissions": [
    "chatbot-ecommerce.read",
    "chatbot-ecommerce.manage-catalogue",
    "chatbot-ecommerce.manage-inventory",
    "chatbot-ecommerce.manage-pricing",
    "chatbot-ecommerce.manage-checkout",
    "chatbot-ecommerce.manage-payments",
